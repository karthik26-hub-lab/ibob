<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target gives access to Wi-Fi, Bluetooth and media controls -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.1.0</Version>
    <ApplicationIcon>ibob.ico</ApplicationIcon>
    <Product>ibob</Product>
    <Description>A dynamic-island style pill for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="ibob.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- PDF merging/creation, PDF text reading, Excel reading -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- Reads calendar (.ics) feeds for the Today page -->
    <PackageReference Include="Ical.Net" Version="4.3.1" />
  </ItemGroup>
</Project>
